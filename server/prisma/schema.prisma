generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Role {

  id          String   @id @default(uuid())
  code        String   @unique 
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique 
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique 
  passwordHash        String    @map("password_hash") 
  name                String
  roleId              String    @map("role_id")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  phoneNumber         String?   @map("phone_number") @db.VarChar(20)
  designation         String?   @map("designation") @db.VarChar(100)
  companyName         String?   @map("company_name") @db.VarChar(200)
  industryType        String?   @map("industry_type") @db.VarChar(100)
  natureOfWork        String?   @map("nature_of_work") @db.VarChar(100)
  revenueBracket      String?   @map("revenue_bracket") @db.VarChar(50)
  product             String?   @map("product") @db.VarChar(200)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  role        Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions    Session[]
  assignments AssessmentAssignment[]
  createdAssessments   Assessment[]         @relation("AssessmentCreator")
  createdQuestions     Question[]           @relation("QuestionCreator")
  assignedAssignments  AssessmentAssignment[] @relation("Assigner")
  auditLogs            AuditLog[]

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Assessment {
  id            String    @id @default(uuid())
  type          String    @default("FINANCIAL_MATURITY")
  status        String    @default("DRAFT")
  title         String
  description   String?
  openAt        DateTime? @map("open_at")
  closeAt       DateTime? @map("close_at")
  publishedAt   DateTime? @map("published_at")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  creator     User?            @relation("AssessmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  sections    Section[]
  questions   Question[]
  assignments AssessmentAssignment[]

  @@index([status])
  @@index([type])
  @@map("assessments")
}

model Section {
  id           String   @id @default(uuid())
  assessmentId String   @map("assessment_id")
  order        Int
  title        String
  sourceText   String?  @map("source_text") 
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  categories Category[]
  questions  Question[]

  @@unique([assessmentId, order])
  @@index([assessmentId])
  @@map("sections")
}

model Category {
  id          String   @id @default(uuid())
  sectionId   String   @map("section_id")
  order       Int
  name        String 
  sourceText  String?  @map("source_text") 
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  section   Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions Question[]
  scores    CategoryScore[]

  @@unique([sectionId, order])
  @@index([sectionId])
  @@map("categories")
}

model Question {
  id           String   @id @default(uuid())
  assessmentId String   @map("assessment_id")
  sourceNumber String?  @map("source_number")
  type         String   @default("SINGLE_SELECT")
  sectionId    String   @map("section_id")
  categoryId   String?  @map("category_id") 
  promptText   String   @map("prompt_text")
  sourceText   String?  @map("source_text") 
  order        Int 
  isRequired   Boolean  @default(true) @map("is_required")
  slotCount    Int?     @map("slot_count") 
  status       String   @default("DRAFT")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator     User?        @relation("QuestionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  options     QuestionOption[]
  responses   Response[]
  textAnswers TextAnswer[]

  @@index([assessmentId])
  @@index([sectionId])
  @@index([categoryId])
  @@map("questions")
}

model QuestionOption {
  id           String   @id @default(uuid())
  questionId   String   @map("question_id")
  order        Int 
  label        String 
  optionText   String   @map("option_text")
  scoreValue   Int      @map("score_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([questionId, order])
  @@unique([questionId, label])
  @@index([questionId])
  @@map("question_options")
}

model AssessmentAssignment {
  id          String    @id @default(uuid())
  assessmentId String   @map("assessment_id")
  userId      String    @map("user_id")
  status      String    @default("ASSIGNED")
  attempt     Int       @default(1)
  dueAt       DateTime? @map("due_at")
  startedAt   DateTime? @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  assignedBy  String?   @map("assigned_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  assigner    User?      @relation("Assigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  responses   Response[]
  textAnswers TextAnswer[]
  result      AssessmentResult?

  @@unique([assessmentId, userId, attempt])
  @@index([userId, status])
  @@index([assessmentId, status])
  @@map("assessment_assignments")
}

model Response {
  id               String   @id @default(uuid())
  assignmentId     String   @map("assignment_id")
  questionId       String   @map("question_id")
  questionOptionId String   @map("question_option_id")
  scoreValue       Int      @map("score_value")
  answeredAt       DateTime @default(now()) @map("answered_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assignment AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option     QuestionOption       @relation(fields: [questionOptionId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, questionId])
  @@index([assignmentId])
  @@index([questionId])
  @@map("responses")
}

model TextAnswer {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  questionId   String   @map("question_id")
  slotIndex    Int      @map("slot_index")
  answerText   String?  @map("answer_text")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignment AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, questionId, slotIndex])
  @@index([assignmentId])
  @@map("text_answers")
}


model AssessmentResult {
  id                String    @id @default(uuid())
  assignmentId      String    @unique @map("assignment_id")
  overallSelf       Decimal?  @db.Decimal(5, 2) @map("overall_self")
  overallOrg        Decimal?  @db.Decimal(5, 2) @map("overall_org")
  overallCombined   Decimal?  @db.Decimal(5, 2) @map("overall_combined")
  minCategoryScore  Decimal?  @db.Decimal(5, 2) @map("min_category_score")
  maxCategoryScore  Decimal?  @db.Decimal(5, 2) @map("max_category_score")
  scoringVersion    String    @map("scoring_version") 
  calculatedAt      DateTime  @default(now()) @map("calculated_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  assignment     AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  categoryScores CategoryScore[]

  @@index([assignmentId])
  @@index([scoringVersion])
  @@map("assessment_results")
}

model CategoryScore {
  id           String   @id @default(uuid())
  resultId     String   @map("result_id")
  categoryId   String   @map("category_id")
  averageScore Decimal  @db.Decimal(5, 2) @map("average_score")
  questionCount Int     @map("question_count")
  minScore     Decimal? @db.Decimal(5, 2) @map("min_score")
  maxScore     Decimal? @db.Decimal(5, 2) @map("max_score")
  result   AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([resultId, categoryId])
  @@index([resultId])
  @@map("category_scores")
}


model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@map("audit_logs")
}
