# --- Server ---
PORT="3001"
# Public base URL of the frontend SPA (used to build password-reset links)
APP_URL="http://localhost:5173"
# --- Database (dev: docker-compose service `db`, host port 5433) ---
DATABASE_URL="postgresql://finance:finance_dev_pw@localhost:5433/finance_dev"
# Isolated database for automated tests (same container, separate logical DB)
TEST_DATABASE_URL="postgresql://finance:finance_dev_pw@localhost:5433/finance_test"
# Production only: direct (non-pooled) connection for `prisma migrate deploy`
# DIRECT_URL=""

# --- Auth.js (@auth/core, Phase 3) ---
AUTH_SECRET="change-me-generate-32-bytes-minimum"
AUTH_URL="http://localhost:3001"

# --- Bootstrap admin (seed only; rotate/remove after first login) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-on-first-login"

# --- SMTP (password reset; optional in dev — links log to console when unset) ---
# Production example:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="smtp-user"
# SMTP_PASSWORD="smtp-pass"
# SMTP_FROM="no-reply@example.com"
#
# Local development with Mailpit (no auth):
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="no-reply@local.test"
#
# Legacy alias (fallback): SMTP_PASS is read if SMTP_PASSWORD is unset
# SMTP_PASS=""
